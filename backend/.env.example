# ============================================================
# CONFIGURACIÓN DEL SISTEMA  (copia este archivo como ".env")
# En Windows:  instalar.bat lo hace automáticamente.
# Los valores de abajo ya sirven para XAMPP con instalación normal.
# ============================================================

# --- Base de datos (MySQL/MariaDB de XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=licoreria_db
# Recomendado en producción: crea un usuario propio (ver database/crear_usuario_mysql.sql)
# y pon aquí su usuario/clave en lugar de root.

# --- Servidor ---
PORT=3000
# Duración de la sesión de cada usuario (14h cubre un turno largo de bar)
JWT_EXPIRES=14h
# La llave que protege las sesiones. Si la dejas vacía se crea sola (backend/data/.jwt_secret).
JWT_SECRET=

# --- Reglas del negocio ---
# false = no deja vender más de lo que hay en stock (recomendado)
# true  = permite vender aunque el sistema crea que no hay stock (útil los primeros días)
PERMITIR_VENTA_SIN_STOCK=false

# --- Seguridad del login ---
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=10

# --- Solo si algún día lo publicas con dominio (Cloudflare Tunnel / Nginx) ---
TRUST_PROXY=false
# Solo para desarrollo con el frontend en otro puerto. Déjalo vacío normalmente.
CORS_ORIGIN=

# --- Respaldos ---
# Carpeta donde se guardan (por defecto: carpeta "respaldos" junto al sistema)
BACKUP_DIR=
# Segunda copia (recomendado): un USB o carpeta sincronizada con Drive/OneDrive. Ej: E:\Respaldos
BACKUP_COPY_DIR=
# Días que se conservan los respaldos
BACKUP_KEEP_DAYS=30
# Ruta de mysqldump si no es la de XAMPP. Ej: C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_PATH=
